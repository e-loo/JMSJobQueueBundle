{
    "name":         "jms/job-queue-bundle",
    "description":  "Allows to run and schedule Symfony console commands as background jobs.",
    "keywords":     ["job","queue", "background", "cron", "scheduled"],
    "homepage":     "http://jmsyst.com/bundles/JMSJobQueueBundle",
    "type":         "symfony-bundle",
    "license":      "Apache-2.0",
    "authors": [
        {
            "name":   "Johannes M. Schmitt",
            "email":  "schmittjoh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 | ^8.3",
        "ext-pcntl": "*",
        "symfony/framework-bundle": "^6.4",
        "symfony/error-handler": "^6.4",
        "doctrine/common": "^3",
        "symfony/process": "^6.4"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "*",
        "symfony/class-loader": "^3",
        "symfony/yaml": "^6.4 | ^7",
        "symfony/browser-kit": "^6.4 | ^7",
        "symfony/finder": "^6.4 | ^7",
        "symfony/css-selector": "^6.4 | ^7",
        "doctrine/doctrine-bundle": "^2",
        "doctrine/orm": "^3",
        "symfony/twig-bundle": "^6.4 | ^7",
        "symfony/form": "^6.4 | ^7",
        "symfony/validator": "^6.4 | ^7",
        "symfony/intl": "^6.4 | ^7",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-deprecation-rules": "^1.2",
        "phpstan/phpstan-phpunit": "^1.4",
        "phpstan/phpstan-symfony": "^1.4",
        "phpunit/phpunit": "^10",
        "rector/rector": "^1",
        "roave/security-advisories": "dev-master"
    },
    "suggest": {
        "symfony/twig-bundle": "Required when using the webinterface."
    },
    "autoload": {
        "psr-4": {
            "JMS\\JobQueueBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JMS\\JobQueueBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
